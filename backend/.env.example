ENVIRONMENT=development
DATABASE_URL=sqlite:///./pme_threats.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentification JWT — générer une valeur forte en production, ex: `openssl rand -hex 32`
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Compte administrateur créé automatiquement au premier démarrage si aucun utilisateur n'existe.
ADMIN_EMAIL=admin@pme-cyber.local
ADMIN_PASSWORD=ChangeMe123!

# Fréquence de la collecte automatique planifiée (minutes).
COLLECTOR_INTERVAL_MINUTES=60
ABUSEIPDB_INTERVAL_MINUTES=360

# Facultatif : améliore les quotas NVD.
NVD_API_KEY=

# Nécessaires pour activer les collecteurs OTX et AbuseIPDB.
OTX_API_KEY=
ABUSEIPDB_API_KEY=
URLHAUS_AUTH_KEY=

# Facultatif : webhook SOC sortant, déclenché à chaque nouvelle alerte (score >= 70).
# Si WEBHOOK_SECRET est défini, chaque envoi est signé en HMAC-SHA256 dans l'en-tête
# X-Sentinel-Signature, afin que le récepteur puisse vérifier l'authenticité.
WEBHOOK_URL=
WEBHOOK_SECRET=

# Notifications directes optionnelles.
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Passerelles d'ingestion SIEM optionnelles. Les URLs sont propres à votre
# installation Wazuh/Elastic et ne sont jamais fournies par Sentinel PME.
WAZUH_WEBHOOK_URL=
WAZUH_TOKEN=
ELASTIC_SIEM_URL=
ELASTIC_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Plusieurs destinataires séparés par des virgules.
ALERT_EMAIL_TO=

# File Redis/RQ optionnelle pour POST /api/collectors/{name}/enqueue.
REDIS_URL=
TASK_QUEUE_NAME=sentinel-collectors
